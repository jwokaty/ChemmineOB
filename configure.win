#!/bin/sh
# configure.win -- find or build Open Babel for Windows, then generate
# src/Makevars.win from src/Makevars.win.in.
#
# Nothing is downloaded or built unless one of these applies:
#   1. OPEN_BABEL_PREFIX points to an existing Open Babel install
#      (it must contain include/openbabel3 and lib/libopenbabel.a).
#      Nothing is downloaded or built. EIGEN_INCLUDE_DIR may point to Eigen 3
#      headers; if unset, $OPEN_BABEL_PREFIX/include/eigen3 is used.
#   2. The build runs on R-universe (the MY_UNIVERSE environment variable is
#      set): Open Babel and Eigen are downloaded and built automatically.
#   3. CHEMMINEOB_BUILD_OPENBABEL=1 is set: same automatic build, requested
#      explicitly by the person installing the package.
# In every other case the install stops with instructions.
set -e

OB_VERSION=3.1.1
OB_URL="https://github.com/openbabel/openbabel/archive/refs/tags/openbabel-3-1-1.tar.gz"
OB_SHA256="c97023ac6300d26176c97d4ef39957f06e68848d64f1a04b0b284ccff2744f02"
OB_TOPDIR="openbabel-openbabel-3-1-1"
EIGEN_URL="https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz"
EIGEN_TOPDIR="eigen-3.4.0"

PKGDIR=$(pwd -W 2>/dev/null || pwd)
WORK="$(pwd)/src/ob-build"
RSCRIPT="${R_HOME}/bin/Rscript"

download() {  # download <url> <destfile>
  "$RSCRIPT" -e "options(timeout=600); download.file('$1', '$2', mode='wb', quiet=TRUE)"
}

if [ -n "$OPEN_BABEL_PREFIX" ]; then
  # Case 1: the person installing the package supplied Open Babel.
  [ -d "$OPEN_BABEL_PREFIX/include/openbabel3" ] || {
    echo "configure.win: OPEN_BABEL_PREFIX is set to '$OPEN_BABEL_PREFIX' but" >&2
    echo "  '$OPEN_BABEL_PREFIX/include/openbabel3' does not exist." >&2
    exit 1
  }
  OB_PREFIX="$OPEN_BABEL_PREFIX"
  EIGEN_DIR="${EIGEN_INCLUDE_DIR:-$OB_PREFIX/include/eigen3}"
  echo "configure.win: using existing Open Babel at $OB_PREFIX"

elif [ -n "$MY_UNIVERSE" ] || [ "$CHEMMINEOB_BUILD_OPENBABEL" = "1" ]; then
  # Cases 2 and 3: automatic build.
  if [ -n "$MY_UNIVERSE" ]; then
    echo "configure.win: R-universe build detected ($MY_UNIVERSE); building Open Babel"
  else
    echo "configure.win: CHEMMINEOB_BUILD_OPENBABEL=1; building Open Babel"
  fi
  command -v cmake >/dev/null 2>&1 || {
    echo "configure.win: cmake is required to build Open Babel on Windows" >&2
    exit 1
  }
  mkdir -p "$WORK"
  cd "$WORK"

  echo "configure.win: downloading Open Babel $OB_VERSION and Eigen"
  download "$OB_URL" ob.tar.gz
  echo "$OB_SHA256  ob.tar.gz" | sha256sum -c - >/dev/null || {
    echo "configure.win: checksum mismatch for Open Babel source" >&2
    exit 1
  }
  download "$EIGEN_URL" eigen.tar.gz
  tar xzf ob.tar.gz
  tar xzf eigen.tar.gz

  WORKW=$(pwd -W 2>/dev/null || pwd)
  OB_PREFIX="$WORKW/install"
  EIGEN_DIR="$WORKW/$EIGEN_TOPDIR"

  # Use the same compilers R uses to build packages
  CC=$("${R_HOME}/bin/R" CMD config CC)
  CXX=$("${R_HOME}/bin/R" CMD config CXX)
  export CC CXX

  mkdir -p build && cd build
  # CMAKE_POLICY_VERSION_MINIMUM: Open Babel 3.1.1 declares an old minimum
  # cmake version, which cmake 4.x refuses without this setting.
  cmake -G "Unix Makefiles" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_SHARED=OFF \
    -DBUILD_MIXED=OFF \
    -DENABLE_TESTS=OFF \
    -DWITH_MAEPARSER=OFF \
    -DWITH_COORDGEN=OFF \
    -DWITH_INCHI=ON \
    -DRUN_SWIG=OFF \
    -DEIGEN3_INCLUDE_DIR="$EIGEN_DIR" \
    -DCMAKE_INSTALL_PREFIX="$OB_PREFIX" \
    "../$OB_TOPDIR"

  JOBS=$(nproc 2>/dev/null || echo 2)
  make -j"$JOBS"
  make install
  cd "$PKGDIR"

else
  # Case 4: nothing was provided and this is not an automated build.
  cat >&2 <<'MSG'
configure.win: Open Babel (>= 3.0.0, static library with headers) and Eigen 3
headers were not found, and ChemmineOB does not download software during a
normal install.

Choose one of:
  1. Install Open Babel and Eigen yourself, then set these environment
     variables before installing ChemmineOB:
       OPEN_BABEL_PREFIX  folder with include/openbabel3 and lib/libopenbabel.a
       EIGEN_INCLUDE_DIR  folder with Eigen 3 headers (optional if they are in
                          $OPEN_BABEL_PREFIX/include/eigen3)
  2. Let the installer download and build Open Babel 3.1.1 and Eigen 3.4.0
     inside the package build folder (needs cmake and internet access):
       set CHEMMINEOB_BUILD_OPENBABEL=1
  3. Install a prebuilt binary of ChemmineOB (for example from R-universe)
     instead of building from source.
MSG
  exit 1
fi

# Find where libopenbabel.a is (lib or lib64)
OB_LIBFILE=$(find "$OB_PREFIX" -name libopenbabel.a | head -n 1)
[ -n "$OB_LIBFILE" ] || { echo "configure.win: libopenbabel.a not found in $OB_PREFIX" >&2; exit 1; }
OB_LIBDIR=$(dirname "$OB_LIBFILE")

cd "$PKGDIR"
sed -e "s|@OB_PREFIX@|$OB_PREFIX|g" \
    -e "s|@OB_LIBDIR@|$OB_LIBDIR|g" \
    -e "s|@EIGEN_DIR@|$EIGEN_DIR|g" \
    src/Makevars.win.in > src/Makevars.win
echo "configure.win: wrote src/Makevars.win"
cat src/Makevars.win
